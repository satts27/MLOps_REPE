FROM python:3.11-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY requirements-backend.txt ./
RUN pip install --upgrade pip && pip install --prefix=/install -r requirements-backend.txt

FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY --from=builder /install /usr/local

WORKDIR /app

COPY backend ./backend
COPY experiments ./experiments

EXPOSE 5000

CMD ["python", "-m", "backend.dashboard_backend"]
