FROM python:3.11-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY requirements-collector.txt ./
RUN pip install --upgrade pip && pip install --prefix=/install -r requirements-collector.txt

FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY --from=builder /install /usr/local

WORKDIR /app

COPY ingestion ./ingestion

CMD ["python", "-m", "ingestion.collect_market_data", "--profile", "nightly"]
